  "version": "1.0.0",
  "license": "MIT",
  "repository": "git+https://github.com/stoatworks-labs/companion-module-weblinked.git",
  "bugs": "https://github.com/stoatworks-labs/companion-module-weblinked/issues",
  "maintainers": [
    {
      "name": "Allan Sargeant",
      "email": ""
    }
  ],
  "runtime": {
    "type": "node22",
    "api": "nodejs-ipc",
    "apiVersion": "0.0.0",
    "entrypoint": "../src/main.js"
  },
  "legacyIds": [],
  "bonjourQueries": {
    "device": {
      "type": "_weblinked._tcp",
      "protocol": "tcp"
    }
  },
  "manufacturer": "Stoatworks Labs",
  "products": ["WebLinked"],
  "keywords": ["ndi", "decklink", "sdi", "graphics", "browser", "cef", "omt"]
